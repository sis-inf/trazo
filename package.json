{
  "name": "trazo",
  "version": "0.1.0",
  "description": "Proyecto Trazo",
  "type": "module",
  "main": "src/index.js",
  "license": "MIT",
  "scripts": {
    "start": "node src/index.js",
    "build": "rollup -c",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch tests",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "typecheck": "tsc -p jsconfig.json --noEmit"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "testMatch": ["**/*.test.js"],
    "moduleFileExtensions": ["js", "mjs"]
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "rollup": "^4.0.0"
  }
}
